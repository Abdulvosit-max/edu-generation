rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isOwner() {
      return isSignedIn() && existing().authorId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidResource(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'type', 'title', 'content', 'createdAt'])
        && data.keys().size() <= 10
        && data.authorId is string && data.authorId.size() <= 128 && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() <= 100
        && data.type in ['image', 'slide', 'chat', 'test']
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 1048487 // 1MB limit safe buffer
        && data.createdAt == request.time
        && data.get('prompt', '') is string
        && data.get('originalId', '') is string;
    }

    match /resources/{resourceId} {
      allow get: if isValidId(resourceId);
      // Client must filter via limit and conditions safely.
      // Wait, instructions say: NO BLANKET READS OR CLIENT DELEGATION.
      // If it's a public feed of resources, how can we restrict them? 
      // If all resources in this collection are meant to be public, we can allow listing if they're public, but for now we just want them generally viewable:
      allow list: if true; // The resources are public for everyone to see and copy

      allow create: if isSignedIn() 
        && isValidId(resourceId) 
        && isValidResource(incoming());
        
      allow update: if isOwner() 
        && isValidId(resourceId)
        && isValidResource(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'type', 'updatedAt'])
        && incoming().authorId == existing().authorId;

      allow delete: if isOwner() && isValidId(resourceId);
    }
  }
}
