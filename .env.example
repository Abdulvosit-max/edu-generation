# =============================================
# EDU-GENERATION — MUHIT O'ZGARUVCHILARI
# Bu faylni .env.local nomi bilan ko'chiring
# va o'z qiymatlaringizni kiriting.
# =============================================

# Gemini AI API kaliti (MAJBURIY)
# Google AI Studio dan oling: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase konfiguratsiyasi (MAJBURIY)
# Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:XXXXXXXXXX:web:XXXXXXXXXX"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="XXXXXXXXXX"
VITE_FIREBASE_FIRESTORE_DB_ID="your-firestore-database-id"
