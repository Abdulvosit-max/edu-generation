{
  "entities": {
    "Resource": {
      "title": "Educational Resource",
      "description": "A generated educational asset (image, slide, or chat snippet) shared with the community.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "slide", "chat", "test"] },
        "title": { "type": "string" },
        "prompt": { "type": "string", "description": "The prompt used to generate this resource" },
        "content": { "type": "string", "description": "JSON string for slides, image URL for images, or text for chat" },
        "originalId": { "type": "string", "description": "If copied from another resource" },
        "createdAt": { "type": "number", "description": "Timestamp" }
      },
      "required": ["authorId", "authorName", "type", "title", "content", "createdAt"]
    }
  },
  "firestore": {
    "resources": {
      "schema": { "$ref": "#/entities/Resource" },
      "description": "Public educational resources"
    }
  }
}
